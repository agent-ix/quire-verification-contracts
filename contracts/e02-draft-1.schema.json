{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.agent-ix.local/quire-verification/e02-draft-1.schema.json",
  "title": "Private E02 verification interface draft",
  "description": "Provisional private interface; not a published normative schema.",
  "oneOf": [
    { "$ref": "#/$defs/TechniqueDefinition" },
    { "$ref": "#/$defs/ToolCapability" },
    { "$ref": "#/$defs/SelectionPolicy" },
    { "$ref": "#/$defs/VerificationPlan" },
    { "$ref": "#/$defs/TechniqueResult" }
  ],
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "required": ["authority", "identity", "revision", "digest", "profile"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Prerequisite": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "Input": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "snapshotRef", "property"],
          "properties": {
            "kind": { "const": "state" },
            "snapshotRef": { "$ref": "#/$defs/ArtifactRef" },
            "property": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind", "leftSubject", "rightSubject", "relation"],
          "properties": {
            "kind": { "const": "relational" },
            "leftSubject": { "type": "string", "minLength": 1 },
            "rightSubject": { "type": "string", "minLength": 1 },
            "relation": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind", "traceRef", "clockProfile", "completion"],
          "properties": {
            "kind": { "const": "trace" },
            "traceRef": { "$ref": "#/$defs/ArtifactRef" },
            "clockProfile": { "type": "string", "minLength": 1 },
            "completion": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind", "faultModelRef", "requestedInjectionSite", "mitigationOracle"],
          "properties": {
            "kind": { "const": "fault" },
            "faultModelRef": { "$ref": "#/$defs/ArtifactRef" },
            "requestedInjectionSite": { "type": "string", "minLength": 1 },
            "mitigationOracle": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind", "reviewProcedure", "requiredDisposition"],
          "properties": {
            "kind": { "const": "manual" },
            "reviewProcedure": { "type": "string", "minLength": 1 },
            "requiredDisposition": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "TechniqueDefinition": {
      "type": "object",
      "required": ["contractVersion", "kind", "techniqueId", "name", "class", "purpose", "applicability", "sourceRef"],
      "properties": {
        "contractVersion": { "const": "quire-verification/e02-draft-1" },
        "kind": { "const": "TechniqueDefinition" },
        "techniqueId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "evidenceKind": { "type": ["string", "null"] },
        "applicability": { "type": "object" },
        "possibleClaims": { "type": "array", "items": { "type": "string" } },
        "legacyToolingHints": { "type": "array", "items": { "type": "string" } },
        "sourceRef": { "$ref": "#/$defs/ArtifactRef" }
      },
      "additionalProperties": true
    },
    "PropertyInventoryItem": {
      "type": "object",
      "required": ["propertyId", "propertyRef", "subjectRefs", "profile", "bindingRefs", "dependencyClosure", "executionScope", "input"],
      "properties": {
        "propertyId": { "type": "string", "minLength": 1 },
        "classification": { "type": "string" },
        "propertyRef": { "$ref": "#/$defs/ArtifactRef" },
        "subjectRefs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactRef" } },
        "profile": { "type": "string", "minLength": 1 },
        "bindingRefs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactRef" } },
        "dependencyClosure": { "type": "string", "minLength": 1 },
        "executionScope": { "type": "object" },
        "resultBinding": { "$ref": "#/$defs/ResultBinding" },
        "input": { "$ref": "#/$defs/Input" }
      },
      "additionalProperties": true
    },
    "ResultBinding": {
      "type": "object",
      "required": ["planId", "taskId", "runRef", "producer", "producerVersion", "adapter", "adapterVersion"],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "runRef": { "$ref": "#/$defs/ArtifactRef" },
        "producer": { "type": "string", "minLength": 1 },
        "producerVersion": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "EvidenceObligation": {
      "allOf": [
        { "$ref": "#/$defs/PropertyInventoryItem" },
        {
          "type": "object",
          "required": ["techniqueId", "resultBinding"],
          "properties": {
            "techniqueId": { "type": "string", "minLength": 1 },
            "resultBinding": { "$ref": "#/$defs/ResultBinding" }
          }
        }
      ]
    },
    "ToolCapability": {
      "type": "object",
      "required": ["contractVersion", "kind", "capabilityId", "techniqueId", "qualification", "inputKinds", "profiles", "prerequisites", "runner", "environmentPermissions", "nativeArtifactInterface"],
      "properties": {
        "contractVersion": { "const": "quire-verification/e02-draft-1" },
        "kind": { "const": "ToolCapability" },
        "capabilityId": { "type": "string", "minLength": 1 },
        "techniqueId": { "type": "string", "minLength": 1 },
        "qualification": { "enum": ["qualified", "provisional", "unqualified"] },
        "inputKinds": {
          "type": "array",
          "items": { "enum": ["state", "relational", "trace", "fault", "manual"] },
          "minItems": 1
        },
        "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/Prerequisite" } },
        "runner": {
          "type": "object",
          "required": ["kind", "adapterId", "adapterVersion"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "adapterId": { "type": "string", "minLength": 1 },
            "adapterVersion": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "environmentPermissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "nativeArtifactInterface": { "type": "object" }
      },
      "additionalProperties": true
    },
    "SelectionPolicy": {
      "type": "object",
      "required": ["contractVersion", "kind", "policyId", "version", "sourceRef", "rules", "provenance"],
      "properties": {
        "contractVersion": { "const": "quire-verification/e02-draft-1" },
        "kind": { "const": "SelectionPolicy" },
        "policyId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "validUntil": { "type": "string", "format": "date-time" },
        "sourceRef": { "$ref": "#/$defs/ArtifactRef" },
        "provenance": {
          "type": "object",
          "properties": {
            "standardDerived": { "type": "boolean" },
            "standard": { "type": "string", "minLength": 1 },
            "edition": { "type": "string", "minLength": 1 },
            "objectives": { "type": "array", "minItems": 1 },
            "interpretation": { "type": "string", "minLength": 1 },
            "rightsDisposition": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": { "standardDerived": { "const": true } },
                "required": ["standardDerived"]
              },
              "then": {
                "type": "object",
                "required": ["standard", "edition", "objectives", "interpretation", "rightsDisposition"],
                "properties": {
                  "standard": true,
                  "edition": true,
                  "objectives": true,
                  "interpretation": true,
                  "rightsDisposition": true
                }
              }
            }
          ],
          "additionalProperties": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ruleId", "priority", "explanation"],
            "properties": {
              "ruleId": { "type": "string", "minLength": 1 },
              "priority": { "enum": ["required", "recommended", "optional"] },
              "explanation": { "type": "string", "minLength": 1 },
              "score": false
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "VerificationPlan": {
      "type": "object",
      "required": ["contractVersion", "kind", "planId", "policyRef", "inventory", "tasks", "evidenceOwner", "sufficiencyOwner"],
      "properties": {
        "contractVersion": { "const": "quire-verification/e02-draft-1" },
        "kind": { "const": "VerificationPlan" },
        "planId": { "type": "string", "minLength": 1 },
        "policyRef": { "type": "object" },
        "inventory": { "type": "array", "items": { "$ref": "#/$defs/PropertyInventoryItem" } },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["taskId", "kind", "propertyId", "techniqueId", "input", "applicability", "readiness", "priority", "dependencies", "missingPrerequisites", "runnerRequest", "invocationAllowed"],
            "properties": {
              "taskId": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["verification", "manual-prerequisite"] },
              "propertyId": { "type": "string", "minLength": 1 },
              "techniqueId": { "type": "string", "minLength": 1 },
              "input": { "$ref": "#/$defs/Input" },
              "applicability": { "enum": ["applicable", "not-applicable", "unknown"] },
              "readiness": { "enum": ["ready", "blocked", "unsupported"] },
              "priority": { "enum": ["required", "recommended", "optional"] },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["rule", "value"],
                  "properties": {
                    "rule": { "type": "string", "minLength": 1 },
                    "value": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": true
                }
              },
              "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "missingPrerequisites": { "type": "array", "items": { "$ref": "#/$defs/Prerequisite" } },
              "gaps": { "type": "array", "items": { "type": "object" } },
              "runnerRequest": {
                "type": ["object", "null"],
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "adapterId": { "type": "string", "minLength": 1 },
                  "adapterVersion": { "type": "string", "minLength": 1 },
                  "capabilityId": { "type": "string", "minLength": 1 },
                  "environmentPermissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "budget": { "type": ["object", "null"] },
                  "nativeArtifactInterface": { "type": "object" }
                },
                "additionalProperties": true
              },
              "invocationAllowed": { "type": "boolean" }
            },
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": { "kind": { "const": "verification" } },
                  "required": ["kind"]
                },
                "then": {
                  "type": "object",
                  "required": ["reasons", "gaps"],
                  "properties": { "reasons": true, "gaps": true }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": { "invocationAllowed": { "const": true } },
                  "required": ["invocationAllowed"]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "applicability": { "const": "applicable" },
                    "readiness": { "const": "ready" }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "evidenceOwner": { "const": "Quoin" },
        "sufficiencyOwner": { "const": "authored-human-decision" }
      },
      "additionalProperties": true
    },
    "NativeArtifact": {
      "type": "object",
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "TechniqueResult": {
      "type": "object",
      "required": ["contractVersion", "kind", "resultId", "planId", "taskId", "runRef", "techniqueId", "producedAt", "propertyRef", "subjectRefs", "profile", "bindingRefs", "dependencyClosure", "executionScope", "execution", "logical", "activation", "participation", "assumptions", "adequacy", "provenance", "nativeArtifacts"],
      "properties": {
        "contractVersion": { "const": "quire-verification/e02-draft-1" },
        "kind": { "const": "TechniqueResult" },
        "resultId": { "type": "string", "minLength": 1 },
        "planId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "runRef": { "$ref": "#/$defs/ArtifactRef" },
        "techniqueId": { "type": "string", "minLength": 1 },
        "producedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "propertyRef": { "$ref": "#/$defs/ArtifactRef" },
        "subjectRefs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactRef" } },
        "profile": { "type": "string", "minLength": 1 },
        "bindingRefs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactRef" } },
        "dependencyClosure": { "type": "string", "minLength": 1 },
        "executionScope": { "type": "object" },
        "execution": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["not-run", "running", "completed", "failed", "cancelled", "exhausted", "invalid-input", "unsupported"] } },
          "additionalProperties": true
        },
        "logical": {
          "type": "object",
          "required": ["outcome"],
          "properties": { "outcome": { "enum": ["satisfied", "violated", "unknown", "not-evaluated", "inconclusive"] } },
          "additionalProperties": true
        },
        "activation": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["activated", "not-activated", "unknown", "not-required"] } },
          "additionalProperties": true
        },
        "participation": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["complete", "partial", "present", "not-started", "unknown", "not-required"] } },
          "additionalProperties": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assumptionId", "status"],
            "properties": {
              "assumptionId": { "type": "string", "minLength": 1 },
              "status": { "enum": ["met", "not-met", "unknown", "not-assessed"] }
            },
            "additionalProperties": true
          }
        },
        "adequacy": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["adequate", "inadequate", "unknown", "not-assessed"] } },
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "required": ["producer", "producerVersion", "adapter", "adapterVersion", "sourceRevision"],
          "properties": {
            "producer": { "type": "string", "minLength": 1 },
            "producerVersion": { "type": "string", "minLength": 1 },
            "adapter": { "type": "string", "minLength": 1 },
            "adapterVersion": { "type": "string", "minLength": 1 },
            "sourceRevision": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "nativeArtifacts": { "type": "array", "items": { "$ref": "#/$defs/NativeArtifact" } }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "execution": {
                "type": "object",
                "properties": { "status": { "not": { "const": "completed" } } },
                "required": ["status"]
              }
            },
            "required": ["execution"]
          },
          "then": {
            "type": "object",
            "properties": {
              "logical": {
                "type": "object",
                "properties": {
                  "outcome": { "not": { "enum": ["satisfied", "violated"] } }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "PortfolioFixture": {
      "type": "object",
      "required": ["schemaVersion", "planRequest"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "planRequest": {
          "type": "object",
          "required": ["planId", "asOf", "policy", "properties", "capabilities", "selections", "availablePrerequisites", "budget"],
          "properties": {
            "planId": { "type": "string", "minLength": 1 },
            "asOf": { "type": "string", "format": "date-time" },
            "policy": { "$ref": "#/$defs/SelectionPolicy" },
            "properties": { "type": "array", "items": { "$ref": "#/$defs/PropertyInventoryItem" } },
            "capabilities": { "type": "array", "items": { "$ref": "#/$defs/ToolCapability" } },
            "selections": { "type": "array", "items": { "type": "object" } },
            "availablePrerequisites": { "type": "array" },
            "budget": { "type": "object" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ResultsFixture": {
      "type": "object",
      "required": ["schemaVersion", "asOf", "inventory", "results"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "inventory": { "type": "array", "items": { "$ref": "#/$defs/EvidenceObligation" } },
        "results": { "type": "array", "items": { "$ref": "#/$defs/TechniqueResult" } }
      },
      "additionalProperties": true
    },
    "QuoinCatalogFixture": {
      "type": "object",
      "required": ["schemaVersion", "source", "catalog"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["quoinRevision", "moduleRevision", "sourceRef"],
          "properties": {
            "quoinRevision": { "type": "string", "minLength": 1 },
            "moduleRevision": { "type": "string", "minLength": 1 },
            "sourceRef": { "$ref": "#/$defs/ArtifactRef" }
          },
          "additionalProperties": true
        },
        "catalog": {
          "type": "object",
          "required": ["methods"],
          "properties": {
            "methods": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "class", "definition", "moduleName"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "class": { "type": "string", "minLength": 1 },
                  "definition": { "type": "string", "minLength": 1 },
                  "moduleName": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "QuoinAdviceFixture": {
      "type": "object",
      "required": ["schemaVersion", "source", "cases", "advice"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["quoinRevision", "moduleRevision"],
          "properties": {
            "quoinRevision": { "type": "string", "minLength": 1 },
            "moduleRevision": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "statement", "archetype"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "statement": { "type": "string", "minLength": 1 },
              "archetype": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "advice": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["obligation", "recommended", "mismatch", "uncatalogued", "inconclusive"],
            "properties": {
              "obligation": { "type": "string", "minLength": 1 },
              "mismatch": { "type": "boolean" },
              "uncatalogued": { "type": "boolean" },
              "inconclusive": { "type": "boolean" },
              "recommended": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["method", "class", "evidenceKind", "reasons"],
                  "properties": {
                    "method": { "type": "string", "minLength": 1 },
                    "class": { "type": "string", "minLength": 1 },
                    "evidenceKind": { "type": "string", "minLength": 1 },
                    "reasons": { "type": "array" }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
